{
  "name": "@thereforejs/foods",
  "version": "0.0.1",
  "description": "An open, maintained food composition database as exact, tree-shakable data for @thereforejs/nutrition, starting from the German BLS 4.0",
  "keywords": [
    "bls",
    "bundeslebensmittelschluessel",
    "food-composition",
    "food-database",
    "lmiv",
    "max-rubner-institut",
    "nutrient-database",
    "nutrition",
    "nutrition-declaration"
  ],
  "homepage": "https://github.com/thereforejs/foods#readme",
  "bugs": {
    "url": "https://github.com/thereforejs/foods/issues"
  },
  "license": "MIT AND CC-BY-4.0",
  "author": "Florian Heuberger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thereforejs/foods.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./names/de": "./dist/names/de.mjs",
    "./names/en": "./dist/names/en.mjs",
    "./sources": "./dist/sources.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "generate": "vpx scripts/generate.ts",
    "import:bls": "vpx scripts/import-bls.ts",
    "food:new": "vpx scripts/food-new.ts",
    "food:set": "vpx scripts/food-set.ts",
    "prepack": "vp run generate && vp check && vp test run && vp pack",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@thereforejs/decy": "^0.1.1",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
